# Projeto "frontend" na Vercel (Root Directory: frontend)
# Cadastre em Settings > Environment Variables (ambiente Production).

# URL pública do projeto do backend na Vercel. Lida no BUILD: após mudar, faça redeploy.
NEXT_PUBLIC_API_BASE_URL=https://colecao-biblica-api.vercel.app

# Envia as imagens do admin ao Vercel Blob.
NEXT_PUBLIC_IMAGE_UPLOADS=blob

# Criada automaticamente ao conectar um Blob Store ao projeto (Storage > Blob > Connect).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
