# Banco PostgreSQL. Localmente: `npm run db:up` sobe o Postgres do docker-compose.
# Em produção (Neon): DATABASE_URL = conexão com pooler (host com "-pooler"),
# DIRECT_URL = conexão direta (sem "-pooler"), usada só pelas migrações.
DATABASE_URL="postgresql://colecao:colecao@localhost:5432/colecao_biblica?schema=public"
DIRECT_URL="postgresql://colecao:colecao@localhost:5432/colecao_biblica?schema=public"

# Chave dos tokens de login. Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-texto-aleatorio-com-pelo-menos-32-caracteres"

PORT=3333

# Fuso usado para o limite diário de partidas premiadas.
APP_TIMEZONE="America/Sao_Paulo"

# Admin criado pelo seed (npm run seed / deploy) se ainda não existir.
# A senha precisa ter pelo menos 8 caracteres. Deixe vazio para não criar.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# Personagens, perguntas e contas de teste (admin2@email.com / user@email.com, senha 123456).
# Use "true" só no desenvolvimento.
SEED_DEMO_DATA="true"

# Upload de imagens no Vercel Blob (Storage -> Create -> Blob na Vercel).
# Sem ele, as imagens são salvas no próprio banco (data URL), como no desenvolvimento.
BLOB_READ_WRITE_TOKEN=""
