# Projeto "backend" na Vercel (Root Directory: backend, build pelo Dockerfile.vercel)
# Cadastre em Settings > Environment Variables (ambiente Production).

# Criada automaticamente ao conectar o banco Neon ao projeto (Storage > Neon).
# Formato aceito: postgresql://usuario:senha@host/banco?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:...@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo do JWT: pelo menos 32 caracteres aleatórios. Gere com: openssl rand -base64 48
JWT_SECRET=

# Domínio(s) do frontend, separados por vírgula
CORS_ALLOWED_ORIGINS=https://colecao-biblica.vercel.app

APP_TIMEZONE=America/Sao_Paulo

# Não criar as contas de demonstração (senha 123456) em produção
SEED_DEMO_USERS=false

# Admin inicial, criado no primeiro start se não existir (senha com 8+ caracteres).
# Depois de entrar e trocar a senha pelo painel, pode remover estas duas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Opcionais
# DATABASE_POOL_SIZE=5
# SHOW_SQL=false
