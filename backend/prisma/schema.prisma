generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  USER
}

enum StickerRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  /// Única e intransferível (ex.: Jesus): só vem da campanha, nunca em pacote, troca, loja ou venda.
  SPECIAL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum RewardType {
  STICKER
  STICKER_PACK
  EXTRA_LIFE
  EXTRA_TIME
  XP_MULTIPLIER
  FIFTY_FIFTY
  STREAK_FREEZE
  COINS
  SKIP_QUESTION
  SECOND_CHANCE
  CROWD_HELP
  VERSE_HINT
  FREEZE_TIME
  DOUBLE_COINS
  COMBO_SHIELD
  COSMETIC
  /// Baús vendidos na loja (o de diamante nunca é vendido).
  CHEST_BRONZE
  CHEST_SILVER
  CHEST_GOLD
}

/// Item visual do jogador.
enum CosmeticType {
  AVATAR
  FRAME
  TITLE
  NAME_COLOR
  REACTION
  PROFILE_BG
  ALBUM_COVER
  /// Peão do tabuleiro (emoji ou imagem); não se equipa, escolhe-se em cada partida.
  PAWN
}

/// Como o item é obtido: grátis para todos, comprado, por meta ou só como prêmio (admin, baú, coleção, passe).
enum CosmeticUnlock {
  FREE
  SHOP
  REQUIREMENT
  REWARD
}

enum Testament {
  OLD
  NEW
}

enum ShopItemType {
  STICKER
  GAME_BONUS
  ECONOMY
}

enum QuizType {
  GENERAL
  CHARACTER_STUDY
  DAILY_CHALLENGE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum QuizSessionStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

/// Sala do Modo Tabuleiro online: LOBBY (reunindo), PLAYING (em jogo) ou FINISHED (pódio na tela).
enum BoardRoomStatus {
  LOBBY
  PLAYING
  FINISHED
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String
  role               Role      @default(USER)
  xp                 Int       @default(0)
  level              Int       @default(1)
  coins              Int       @default(0)
  totalScore         Int       @default(0) @map("total_score")
  extraLifeBoosts    Int       @default(0) @map("extra_life_boosts")
  extraTimeBoosts    Int       @default(0) @map("extra_time_boosts")
  doubleXpBoosts     Int       @default(0) @map("double_xp_boosts")
  hintBoosts         Int       @default(0) @map("hint_boosts")
  dailyStreak        Int       @default(0) @map("daily_streak")
  lastDailyClaim     DateTime? @map("last_daily_claim")
  streakFreezes      Int       @default(0) @map("streak_freezes")
  stickerPity        Int       @default(0) @map("sticker_pity")
  /// Código para adicionar como amigo (gerado no primeiro acesso à tela de amigos).
  friendCode         String?   @unique @map("friend_code")
  skipBoosts         Int       @default(0) @map("skip_boosts")
  secondChanceBoosts Int       @default(0) @map("second_chance_boosts")
  crowdBoosts        Int       @default(0) @map("crowd_boosts")
  verseHintBoosts    Int       @default(0) @map("verse_hint_boosts")
  freezeTimeBoosts   Int       @default(0) @map("freeze_time_boosts")
  doubleCoinsBoosts  Int       @default(0) @map("double_coins_boosts")
  comboShieldBoosts  Int       @default(0) @map("combo_shield_boosts")
  /// Maior sequência de acertos numa partida.
  bestCombo          Int       @default(0) @map("best_combo")
  /// Último nível cujo baú já foi aberto (baús pendentes = level - chestLevel).
  chestLevel         Int       @default(1) @map("chest_level")
  avatarId           Int?      @map("avatar_id")
  frameId            Int?      @map("frame_id")
  titleId            Int?      @map("title_id")
  nameColorId        Int?      @map("name_color_id")
  profileBgId        Int?      @map("profile_bg_id")
  albumCoverId       Int?      @map("album_cover_id")
  /// Figurinhas escolhidas para a vitrine do perfil (até 3).
  showcase           Int[]     @default([])
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String    @map("created_by")
  updatedBy          String?   @map("updated_by")
  deleted            Boolean   @default(false)
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by")

  stickers     UserSticker[]
  studies      CharacterStudy[]
  comments     UserComment[]
  quizMatches  QuizMatch[]
  quizSessions QuizSession[]
  achievements UserAchievement[]
  claims       UserClaim[]
  reports      QuestionReport[]
  cosmetics    UserCosmetic[]

  avatar     Cosmetic? @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  frame      Cosmetic? @relation("UserFrame", fields: [frameId], references: [id], onDelete: SetNull)
  title      Cosmetic? @relation("UserTitle", fields: [titleId], references: [id], onDelete: SetNull)
  nameColor  Cosmetic? @relation("UserNameColor", fields: [nameColorId], references: [id], onDelete: SetNull)
  profileBg  Cosmetic? @relation("UserProfileBg", fields: [profileBgId], references: [id], onDelete: SetNull)
  albumCover Cosmetic? @relation("UserAlbumCover", fields: [albumCoverId], references: [id], onDelete: SetNull)

  friendRequestsSent     Friendship[]      @relation("FriendshipRequester")
  friendRequestsReceived Friendship[]      @relation("FriendshipAddressee")
  messagesSent           Message[]         @relation("MessageSender")
  messagesReceived       Message[]         @relation("MessageReceiver")
  tradesProposed         Trade[]           @relation("TradeProposer")
  tradesReceived         Trade[]           @relation("TradeReceiver")
  /// Vitórias em salas online do Tabuleiro (só conta com 2 ou mais pessoas na sala).
  boardWins              Int               @default(0) @map("board_wins")
  hostedBoardRooms       BoardRoom[]       @relation("BoardRoomHost")
  boardPlayers           BoardRoomPlayer[]
  sentBoardInvites       BoardInvite[]     @relation("BoardInviteFrom")
  receivedBoardInvites   BoardInvite[]     @relation("BoardInviteTo")

  @@index([totalScore, xp])
  @@map("users")
}

model BiblicalCharacter {
  id               Int           @id @default(autoincrement())
  name             String        @unique
  imageUrl         String?       @map("image_url")
  rarity           StickerRarity
  testament        Testament?
  published        Boolean       @default(true)
  /// Publicação agendada: com published = true, só aparece a partir desta data.
  publishAt        DateTime?     @map("publish_at")
  shortSummary     String        @map("short_summary")
  fullDescription  String        @map("full_description")
  bibleBooks       String?       @map("bible_books")
  bibleReferences  String?       @map("bible_references")
  historicalPeriod String?       @map("historical_period")
  narrativeRole    String?       @map("narrative_role")
  genealogy        String?
  curiosities      String?
  importantEvents  String?       @map("important_events")
  keyVerses        String?       @map("key_verses")
  keywords         String?
  createdAt        DateTime      @default(now()) @map("created_at")
  createdBy        String        @map("created_by")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  questions         Question[]
  stickers          UserSticker[]
  studies           CharacterStudy[]
  tradesOffered     Trade[]               @relation("TradeOffered")
  tradesRequested   Trade[]               @relation("TradeRequested")
  comments          UserComment[]
  quizSessions      QuizSession[]
  stickerReward     RewardDefinition[]
  collections       CharacterCollection[] @relation("CollectionCharacters")
  campaignScenarios Scenario[]            @relation("ScenarioFragmentCharacter")

  @@map("biblical_characters")
}

model Question {
  id                 Int                @id @default(autoincrement())
  text               String
  difficulty         QuestionDifficulty
  timeLimitSeconds   Int                @map("time_limit_seconds")
  optionA            String             @map("option_a")
  optionB            String             @map("option_b")
  optionC            String             @map("option_c")
  optionD            String             @map("option_d")
  correctOption      String             @map("correct_option") @db.Char(1)
  relatedCharacterId Int?               @map("character_id")
  /// Pergunta ligada a um cenário da campanha (entra com prioridade nas partidas de quem está nele).
  scenarioId         Int?               @map("scenario_id")
  explanation        String?
  bibleReference     String?            @map("bible_reference")
  active             Boolean            @default(true)
  timesAnswered      Int                @default(0) @map("times_answered")
  timesCorrect       Int                @default(0) @map("times_correct")
  /// Quantas vezes cada alternativa foi escolhida (voz da multidão).
  answersA           Int                @default(0) @map("answers_a")
  answersB           Int                @default(0) @map("answers_b")
  answersC           Int                @default(0) @map("answers_c")
  answersD           Int                @default(0) @map("answers_d")

  relatedCharacter BiblicalCharacter? @relation(fields: [relatedCharacterId], references: [id], onDelete: SetNull)
  scenario         Scenario?          @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  reports          QuestionReport[]

  @@index([active, relatedCharacterId])
  @@index([active, scenarioId])
  @@map("questions")
}

model RewardDefinition {
  id                 Int            @id @default(autoincrement())
  name               String         @unique
  rewardType         RewardType     @map("reward_type")
  stickerRarity      StickerRarity? @map("sticker_rarity")
  stickerCharacterId Int?           @map("sticker_character_id")
  coinAmount         Int?           @map("coin_amount")
  extraLives         Int?           @map("extra_lives")
  extraTimeSeconds   Int?           @map("extra_time_seconds")
  xpMultiplier       Float?         @map("xp_multiplier")
  hintAmount         Int?           @map("hint_amount")
  /// Quantidade das ajudas novas (pular, segunda chance...).
  boostAmount        Int?           @map("boost_amount")
  cosmeticId         Int?           @map("cosmetic_id")
  dropChance         Float          @map("drop_chance")
  active             Boolean        @default(true)
  system             Boolean        @default(false)

  stickerCharacter   BiblicalCharacter? @relation(fields: [stickerCharacterId], references: [id], onDelete: SetNull)
  cosmetic           Cosmetic?          @relation(fields: [cosmeticId], references: [id], onDelete: SetNull)
  shopItems          ShopItem[]
  passTiers          PassTier[]
  passTierDuplicates PassTier[]         @relation("PassTierDuplicate")
  scenarioNodes      ScenarioNode[]
  missions           Mission[]

  @@map("reward_definitions")
}

model ShopItem {
  id                 Int          @id @default(autoincrement())
  name               String       @unique
  description        String
  itemType           ShopItemType @map("item_type")
  priceCoins         Int          @map("price_coins")
  rewardDefinitionId Int?         @map("reward_definition_id")
  active             Boolean      @default(true)
  system             Boolean      @default(false)

  rewardDefinition RewardDefinition? @relation(fields: [rewardDefinitionId], references: [id], onDelete: SetNull)

  @@map("shop_items")
}

model UserSticker {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  characterId Int      @map("character_id")
  acquiredAt  DateTime @default(now()) @map("acquired_at")
  /// Cópias repetidas guardadas para vender, trocar, fundir ou subir o nível.
  duplicates  Int      @default(0)
  /// Nível da figurinha (1 a 5), sobe gastando repetidas dela. Hoje só enfeita; vai valer no modo de cartas.
  level       Int      @default(1)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  character BiblicalCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("user_stickers")
}

/// Estudo de personagem: só acumula acertos por personagem (vira um status, sem prêmios).
model CharacterStudy {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  characterId       Int      @map("character_id")
  correctAnswers    Int      @default(0) @map("correct_answers")
  questionsAnswered Int      @default(0) @map("questions_answered")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  character BiblicalCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("character_studies")
}

model UserComment {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  characterId Int      @map("character_id")
  text        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  character BiblicalCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("user_comments")
}

model QuizMatch {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  quizType          QuizType  @map("quiz_type")
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime  @map("finished_at")
  questionsAnswered Int       @map("questions_answered")
  correctAnswers    Int       @map("correct_answers")
  wrongAnswers      Int       @map("wrong_answers")
  xpGained          Int       @map("xp_gained")
  scoreGained       Int       @map("score_gained")
  coinsGained       Int       @default(0) @map("coins_gained")
  rewardGranted     Boolean   @default(false) @map("reward_granted")
  rewardGrantedName String?   @map("reward_granted_name")
  /// Baú da partida ganho (BRONZE, SILVER, GOLD ou DIAMOND).
  chestTier         String?   @map("chest_tier")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, finishedAt])
  @@index([quizType, finishedAt])
  @@map("quiz_matches")
}

model QuizSession {
  id                          Int               @id @default(autoincrement())
  userId                      Int               @map("user_id")
  quizType                    QuizType          @map("quiz_type")
  characterId                 Int?              @map("character_id")
  status                      QuizSessionStatus
  startedAt                   DateTime          @default(now()) @map("started_at")
  finishedAt                  DateTime?         @map("finished_at")
  totalQuestions              Int               @map("total_questions")
  currentQuestionIndex        Int               @default(0) @map("current_question_index")
  livesRemaining              Int               @map("lives_remaining")
  correctAnswers              Int               @default(0) @map("correct_answers")
  wrongAnswers                Int               @default(0) @map("wrong_answers")
  xpMultiplier                Float             @default(1) @map("xp_multiplier")
  extraTimeUsed               Boolean           @default(false) @map("extra_time_used")
  extraLifeUsed               Boolean           @default(false) @map("extra_life_used")
  xpMultiplierUsed            Boolean           @default(false) @map("xp_multiplier_used")
  fiftyFiftyUsed              Boolean           @default(false) @map("fifty_fifty_used")
  fiftyFiftyQuestionId        Int?              @map("fifty_fifty_question_id")
  fiftyFiftyRemoved           String?           @map("fifty_fifty_removed")
  /// Treino (número de perguntas escolhido): não rende baú. Sem o treino, a partida vai até as vidas acabarem.
  training                    Boolean           @default(false)
  questionIds                 Int[]             @map("question_ids")
  currentQuestionStartedAt    DateTime?         @map("current_question_started_at")
  currentQuestionExtraSeconds Int               @default(0) @map("current_question_extra_seconds")
  skipUsed                    Boolean           @default(false) @map("skip_used")
  secondChanceUsed            Boolean           @default(false) @map("second_chance_used")
  secondChanceQuestionId      Int?              @map("second_chance_question_id")
  /// Alternativa errada já tentada com a segunda chance.
  secondChanceRemoved         String?           @map("second_chance_removed") @db.Char(1)
  crowdUsed                   Boolean           @default(false) @map("crowd_used")
  crowdQuestionId             Int?              @map("crowd_question_id")
  verseHintUsed               Boolean           @default(false) @map("verse_hint_used")
  verseHintQuestionId         Int?              @map("verse_hint_question_id")
  freezeUsed                  Boolean           @default(false) @map("freeze_used")
  frozenQuestionId            Int?              @map("frozen_question_id")
  doubleCoinsUsed             Boolean           @default(false) @map("double_coins_used")
  comboShieldUsed             Boolean           @default(false) @map("combo_shield_used")
  comboShieldArmed            Boolean           @default(false) @map("combo_shield_armed")
  comboStreak                 Int               @default(0) @map("combo_streak")
  bestCombo                   Int               @default(0) @map("best_combo")
  comboPoints                 Int               @default(0) @map("combo_points")
  comboCoins                  Int               @default(0) @map("combo_coins")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  character BiblicalCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("quiz_sessions")
}

model UserAchievement {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  code       String
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("user_achievements")
}

/// Prêmios resgatados uma vez por período (missões, liga semanal).
model UserClaim {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  kind      String
  code      String
  periodKey String   @map("period_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, code, periodKey])
  @@map("user_claims")
}

/// Pergunta marcada pelo jogador como errada ou confusa.
model QuestionReport {
  id         Int          @id @default(autoincrement())
  questionId Int          @map("question_id")
  userId     Int          @map("user_id")
  reason     String
  message    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")
  resolvedBy String?      @map("resolved_by")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("question_reports")
}

model GameSetting {
  id           Int     @id @default(autoincrement())
  settingKey   String  @unique @map("setting_key")
  settingValue String  @map("setting_value")
  description  String?

  @@map("game_settings")
}

/// Amizade: pedido de requester para addressee. BLOCKED: requester bloqueou addressee.
model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int              @map("requester_id")
  addresseeId Int              @map("addressee_id")
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

/// Mensagem entre amigos. Com tradeId, é o aviso de uma proposta de troca.
model Message {
  id         Int       @id @default(autoincrement())
  senderId   Int       @map("sender_id")
  receiverId Int       @map("receiver_id")
  text       String
  tradeId    Int?      @map("trade_id")
  /// Reação animada (item visual do tipo REACTION).
  reactionId Int?      @map("reaction_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  readAt     DateTime? @map("read_at")

  sender   User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  trade    Trade?    @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  reaction Cosmetic? @relation(fields: [reactionId], references: [id], onDelete: SetNull)

  @@index([senderId, receiverId, id])
  @@index([receiverId, readAt])
  @@map("messages")
}

/// Troca de figurinhas repetidas: oferece uma, pede outra (ou só uma das duas: presente/pedido).
model Trade {
  id                   Int         @id @default(autoincrement())
  proposerId           Int         @map("proposer_id")
  receiverId           Int         @map("receiver_id")
  offeredCharacterId   Int?        @map("offered_character_id")
  requestedCharacterId Int?        @map("requested_character_id")
  message              String?
  /// Venda a amigo: preço padrão da raridade (o comprador paga) e o que o vendedor recebe já sem a taxa.
  priceCoins           Int?        @map("price_coins")
  sellerCoins          Int?        @map("seller_coins")
  status               TradeStatus @default(PENDING)
  createdAt            DateTime    @default(now()) @map("created_at")
  respondedAt          DateTime?   @map("responded_at")

  proposer           User               @relation("TradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  receiver           User               @relation("TradeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  offeredCharacter   BiblicalCharacter? @relation("TradeOffered", fields: [offeredCharacterId], references: [id], onDelete: Cascade)
  requestedCharacter BiblicalCharacter? @relation("TradeRequested", fields: [requestedCharacterId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@index([receiverId, status])
  @@index([proposerId, status])
  @@map("trades")
}

/// Item visual cadastrado pelo admin: ícone, moldura, título, cor do nome ou reação do chat.
model Cosmetic {
  id               Int            @id @default(autoincrement())
  type             CosmeticType
  name             String
  description      String?
  rarity           StickerRarity  @default(COMMON)
  /// Imagem do ícone, da reação ou da moldura.
  imageUrl         String?        @map("image_url")
  /// Cor principal (título, cor do nome, moldura), em #rrggbb.
  color            String?
  /// Efeito: títulos (plain, glow, rainbow, pulse) e molduras (solid, wood, silver, gold, fire, rainbow).
  style            String?
  /// Reações: como a figurinha entra no chat (pop, bounce, shake, spin, rise, pulse).
  animation        String?
  /// Reações: grupo/pacote (ex.: "Natal"); o seletor do chat agrupa por ele.
  pack             String?
  unlock           CosmeticUnlock
  priceCoins       Int?           @map("price_coins")
  /// Meta para os de unlock REQUIREMENT (ex.: LEVEL, ALBUM_COMPLETE, BEST_COMBO).
  requirement      String?
  requirementValue Int?           @map("requirement_value")
  /// Pode sair no baú de nível.
  inChestPool      Boolean        @default(false) @map("in_chest_pool")
  /// Só fica à venda durante o evento.
  eventId          Int?           @map("event_id")
  active           Boolean        @default(true)
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  /// Itens padrão do sistema (criados no deploy; o admin pode desativar, não excluir).
  system           Boolean        @default(false)

  event             GameEvent?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  owners            UserCosmetic[]
  avatarOf          User[]                @relation("UserAvatar")
  frameOf           User[]                @relation("UserFrame")
  titleOf           User[]                @relation("UserTitle")
  nameColorOf       User[]                @relation("UserNameColor")
  profileBgOf       User[]                @relation("UserProfileBg")
  albumCoverOf      User[]                @relation("UserAlbumCover")
  messages          Message[]
  rewards           RewardDefinition[]
  collections       CharacterCollection[]
  passTiers         PassTier[]
  scenarioNodes     ScenarioNode[]
  avatarOfScenarios Scenario[]            @relation("ScenarioAvatar")

  @@unique([type, name])
  @@index([type, active])
  @@map("cosmetics")
}

model UserCosmetic {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  cosmeticId Int      @map("cosmetic_id")
  /// De onde veio: FREE, SHOP, REQUIREMENT, ADMIN, CHEST, COLLECTION, PASS, REWARD.
  source     String
  acquiredAt DateTime @default(now()) @map("acquired_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@map("user_cosmetics")
}

/// Coleção temática (ex.: os 12 apóstolos): completar dá um prêmio único.
model CharacterCollection {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  description      String?
  rewardCoins      Int      @default(0) @map("reward_coins")
  rewardCosmeticId Int?     @map("reward_cosmetic_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  rewardCosmetic Cosmetic?           @relation(fields: [rewardCosmeticId], references: [id], onDelete: SetNull)
  characters     BiblicalCharacter[] @relation("CollectionCharacters")

  @@map("character_collections")
}

/// Passe temático (Natal, Páscoa...). Um passe vale por mês: o fixado naquele mês ou, senão, o sorteado em rodízio entre os ativos.
model Pass {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  /// Cor do tema, em #rrggbb.
  color       String?
  imageUrl    String?  @map("image_url")
  /// Fixa o passe num mês ("AAAA-MM"), ex.: Natal em dezembro.
  pinnedMonth String?  @map("pinned_month")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  tiers PassTier[]

  @@map("passes")
}

/// Degrau de um passe (a trilha recomeça todo mês; o progresso é o XP do mês).
model PassTier {
  id                          Int     @id @default(autoincrement())
  passId                      Int     @map("pass_id")
  level                       Int
  requiredXp                  Int     @map("required_xp")
  rewardCoins                 Int     @default(0) @map("reward_coins")
  rewardDefinitionId          Int?    @map("reward_definition_id")
  rewardCosmeticId            Int?    @map("reward_cosmetic_id")
  /// Moedas quando o jogador já tem o item visual do degrau (vazio = valor padrão da raridade).
  duplicateCoins              Int?    @map("duplicate_coins")
  /// Recompensa extra quando o item visual já é do jogador (ajuda, pacote...).
  duplicateRewardDefinitionId Int?    @map("duplicate_reward_definition_id")
  active                      Boolean @default(true)

  pass                      Pass              @relation(fields: [passId], references: [id], onDelete: Cascade)
  rewardDefinition          RewardDefinition? @relation(fields: [rewardDefinitionId], references: [id], onDelete: SetNull)
  rewardCosmetic            Cosmetic?         @relation(fields: [rewardCosmeticId], references: [id], onDelete: SetNull)
  duplicateRewardDefinition RewardDefinition? @relation("PassTierDuplicate", fields: [duplicateRewardDefinitionId], references: [id], onDelete: SetNull)

  @@unique([passId, level])
  @@map("pass_tiers")
}

/// Missão diária ou semanal. `metric` diz o que é contado (partidas, acertos...); o prêmio é moedas e/ou uma recompensa.
model Mission {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  /// DAILY ou WEEKLY.
  period             String
  metric             String
  title              String
  target             Int
  rewardCoins        Int     @default(0) @map("reward_coins")
  rewardDefinitionId Int?    @map("reward_definition_id")
  active             Boolean @default(true)
  /// As do seed não são excluíveis (só desativadas); as criadas no painel têm system = false.
  system             Boolean @default(false)
  sortOrder          Int     @default(0) @map("sort_order")

  rewardDefinition RewardDefinition? @relation(fields: [rewardDefinitionId], references: [id], onDelete: SetNull)

  @@map("missions")
}

/// Evento por tempo limitado (Páscoa, Natal...): multiplica XP/moedas e libera itens na loja.
model GameEvent {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  xpMultiplier   Float    @default(1) @map("xp_multiplier")
  coinMultiplier Float    @default(1) @map("coin_multiplier")
  color          String?
  /// Imagem do banner do evento (aparece na faixa da tela inicial no lugar do degradê).
  imageUrl       String?  @map("image_url")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  cosmetics Cosmetic[]

  @@index([startsAt, endsAt])
  @@map("game_events")
}

/// Cenário da campanha (Jardim do Éden, Egito...): um trecho do caminho com tema, mapa e recompensas próprios.
model Scenario {
  id                  Int      @id @default(autoincrement())
  /// Identificador estável (eden, egito...); também escolhe o tema visual pronto do app.
  slug                String   @unique
  name                String
  description         String?
  /// Versículo exibido ao concluir o cenário.
  verse               String?
  verseReference      String?  @map("verse_reference")
  /// Cor de destaque do cenário, em #rrggbb (substitui a do tema pronto).
  color               String?
  /// Arte do mapa-caminho (proporção 3:4) e ícone do cenário (quadrado).
  mapImageUrl         String?  @map("map_image_url")
  iconImageUrl        String?  @map("icon_image_url")
  /// Música do tema do cenário (liberada quando o jogador chega ao primeiro nível dele).
  musicUrl            String?  @map("music_url")
  /// Imagem de fundo da tela do quiz neste cenário (vertical, sem texto).
  quizBackgroundUrl   String?  @map("quiz_background_url")
  /// Imagem de fundo do tabuleiro deste cenário (vertical, sem texto), atrás do caminho do jogo de tabuleiro.
  boardImageUrl       String?  @map("board_image_url")
  /// Curvas do caminho do tabuleiro: SOFT, MEDIUM ou WIDE (vazio = MEDIUM).
  boardPathStyle      String?  @map("board_path_style")
  /// Marcos do cenário ao lado do caminho: [{ imageUrl?, emoji?, at (0-100), side (L/R), offset, size }].
  boardLandmarks      Json?    @map("board_landmarks")
  /// Personagem cujos fragmentos este cenário dá (a carta especial).
  fragmentCharacterId Int?     @map("fragment_character_id")
  /// Ícone de perfil (avatar) com a arte do cenário, entregue junto com a relíquia.
  avatarCosmeticId    Int?     @map("avatar_cosmetic_id")
  sortOrder           Int      @default(0) @map("sort_order")
  active              Boolean  @default(true)
  /// Criado no deploy (não excluível; o admin pode editar e desativar).
  system              Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")

  fragmentCharacter BiblicalCharacter? @relation("ScenarioFragmentCharacter", fields: [fragmentCharacterId], references: [id], onDelete: SetNull)
  avatarCosmetic    Cosmetic?          @relation("ScenarioAvatar", fields: [avatarCosmeticId], references: [id], onDelete: SetNull)
  nodes             ScenarioNode[]
  questions         Question[]
  boardRooms        BoardRoom[]

  @@index([sortOrder])
  @@map("scenarios")
}

/// Parada do caminho: abre quando o jogador chega ao nível; só existe um nó por nível na campanha toda.
model ScenarioNode {
  id                 Int     @id @default(autoincrement())
  scenarioId         Int     @map("scenario_id")
  level              Int     @unique
  title              String?
  /// Última parada do cenário: a relíquia (recompensa maior).
  relic              Boolean @default(false)
  /// Dá um fragmento da carta especial do cenário.
  fragment           Boolean @default(false)
  rewardCoins        Int     @default(0) @map("reward_coins")
  rewardDefinitionId Int?    @map("reward_definition_id")
  rewardCosmeticId   Int?    @map("reward_cosmetic_id")
  /// Posição no mapa em % (0 a 100); vazio, o app distribui em zigue-zague.
  posX               Int?    @map("pos_x")
  posY               Int?    @map("pos_y")

  scenario         Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  rewardDefinition RewardDefinition? @relation(fields: [rewardDefinitionId], references: [id], onDelete: SetNull)
  rewardCosmetic   Cosmetic?         @relation(fields: [rewardCosmeticId], references: [id], onDelete: SetNull)

  @@index([scenarioId])
  @@map("scenario_nodes")
}

/// Visual de cada baú da partida (BRONZE, SILVER, GOLD, DIAMOND), cadastrado no painel.
model ChestDesign {
  id           Int      @id @default(autoincrement())
  tier         String   @unique
  /// Arte do baú fechado (quadrada, fundo transparente fica melhor).
  imageUrl     String?  @map("image_url")
  /// Arte do baú aberto (mesmo enquadramento do fechado): aparece no instante em que ele abre.
  openImageUrl String?  @map("open_image_url")
  /// Nome exibido (vazio usa o padrão) e cor de destaque do brilho.
  name         String?
  color        String?
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("chest_designs")
}

/// Sala online do Tabuleiro. Dura pouco: o servidor apaga as de mais de um dia. O motor (state) e as
/// respostas certas (pool) ficam aqui; o cliente nunca recebe a alternativa certa antes do gabarito.
model BoardRoom {
  id         Int             @id @default(autoincrement())
  /// Código curto para entrar (sem letras que se confundem).
  code       String          @unique
  hostId     Int             @map("host_id")
  scenarioId Int             @map("scenario_id")
  status     BoardRoomStatus @default(LOBBY)
  /// Regras da sala (tamanho, tempo, power-ups, empurrão, ajuda).
  config     Json
  /// Estado do motor (backend/src/board/engine.ts).
  state      Json?
  /// Perguntas da partida com a alternativa certa: [{ id, difficulty, correct }].
  pool       Json?
  /// Resposta dada e ainda não aplicada (todos veem o gabarito antes de seguir).
  reveal     Json?
  /// Últimas jogadas, em texto.
  log        Json            @default("[]")
  /// Avisos animados recentes (calloutsFor): [{ id, emoji, title, text, tone, tiles, playerId, fx, delayMs }].
  feed       Json            @default("[]")
  /// Sobe a cada mudança; o cliente só baixa a sala quando muda.
  version    Int             @default(1)
  /// Quando o servidor precisa agir sozinho (bot, tempo esgotado, fim do gabarito).
  dueAt      DateTime?       @map("due_at")
  /// Fim do tempo do jogador da vez (cronômetro).
  deadlineAt DateTime?       @map("deadline_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  startedAt  DateTime?       @map("started_at")
  finishedAt DateTime?       @map("finished_at")

  host     User              @relation("BoardRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  scenario Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  players  BoardRoomPlayer[]
  invites  BoardInvite[]

  @@index([status, updatedAt])
  @@map("board_rooms")
}

/// Quem está na sala: pessoa (userId) ou bot (bot = nível). Quem sai no meio do jogo vira bot (replaced).
model BoardRoomPlayer {
  id         Int      @id @default(autoincrement())
  roomId     Int      @map("room_id")
  userId     Int?     @map("user_id")
  slot       Int
  name       String
  /// Emoji ou endereço da imagem do peão.
  pawn       String
  /// APPRENTICE, STUDENT ou MASTER quando é bot.
  bot        String?
  /// Era uma pessoa e um bot assumiu o lugar (saiu ou ficou ausente).
  replaced   Boolean  @default(false)
  afkStrikes Int      @default(0) @map("afk_strikes")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  joinedAt   DateTime @default(now()) @map("joined_at")

  room BoardRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, slot])
  @@unique([roomId, userId])
  @@index([userId])
  @@map("board_room_players")
}

/// Convite de um amigo para uma sala ainda reunindo gente.
model BoardInvite {
  id         Int      @id @default(autoincrement())
  roomId     Int      @map("room_id")
  fromUserId Int      @map("from_user_id")
  toUserId   Int      @map("to_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  room BoardRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  from User      @relation("BoardInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User      @relation("BoardInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([roomId, toUserId])
  @@index([toUserId, createdAt])
  @@map("board_invites")
}
