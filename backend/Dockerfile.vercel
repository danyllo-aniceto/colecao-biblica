# Container do backend para a Vercel (projeto com Root Directory = backend).
# A Vercel constrói esta imagem e a executa sob demanda; o servidor escuta em $PORT.

# ---- build ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace

# Baixa as dependências antes do código para aproveitar o cache de camadas.
COPY pom.xml ./
RUN mvn -B -q dependency:go-offline

COPY src src
RUN mvn -B -q -Dmaven.test.skip=true package && cp target/*.jar app.jar

# ---- runtime ----
FROM eclipse-temurin:21-jre
WORKDIR /app

COPY --from=build /workspace/app.jar app.jar

# A Vercel encaminha o tráfego para a porta 80 (ou para $PORT, se definida no projeto).
# Roda como root porque portas abaixo de 1024 exigem privilégio; o container já é isolado pela Vercel.
ENV PORT=80
# Menos tempo de inicialização (instâncias sobem sob demanda) e memória proporcional ao container.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k"
EXPOSE 80

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
